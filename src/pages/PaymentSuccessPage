import React, { useEffect, useState } from 'react';
import { useSearchParams, useNavigate } from 'react-router-dom';
import { paymentsAPI } from '../api';

function PaymentSuccessPage() {
  var searchParamsHook = useSearchParams();
  var searchParams = searchParamsHook[0];
  var navigate = useNavigate();
  var statusState = useState('verifying');
  var status = statusState[0];
  var setStatus = statusState[1];
  var orderDataState = useState(null);
  var orderData = orderDataState[0];
  var setOrderData = orderDataState[1];
  var errorState = useState(null);
  var error = errorState[0];
  var setError = errorState[1];

  useEffect(function() {
    var verifyPayment = async function() {
      var reference = searchParams.get('reference') || searchParams.get('trxref');
      
      if (!reference) {
        setStatus('failed');
        setError('No payment reference found.');
        return;
      }

      try {
        var response = await paymentsAPI.verifyPayment(reference);
        if (response.success) {
          setOrderData(response.data);
          setStatus('success');
        } else {
          throw new Error('Payment verification failed');
        }
      } catch (err) {
        setStatus('failed');
        setError(err.message);
      }
    };
    verifyPayment();
  }, [searchParams]);

  var containerStyle = {
    minHeight: '100vh',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'center',
    padding: '20px',
    backgroundColor: '#fdf2f8'
  };

  var cardStyle = {
    backgroundColor: 'white',
    borderRadius: '20px',
    padding: '40px',
    maxWidth: '500px',
    width: '100%',
    textAlign: 'center',
    boxShadow: '0 10px 40px rgba(0,0,0,0.1)'
  };

  var buttonStyle = {
    backgroundColor: '#ec4899',
    color: 'white',
    padding: '15px 30px',
    border: 'none',
    borderRadius: '10px',
    fontSize: '16px',
    cursor: 'pointer',
    marginTop: '20px',
    marginRight: '10px'
  };

  var successTitleStyle = {
    color: '#10b981',
    fontSize: '28px',
    marginBottom: '20px'
  };

  var handleGoHome = function() {
    navigate('/');
  };

  var handleShopMore = function() {
    navigate('/shop');
  };

  if (status === 'verifying') {
    return React.createElement('div', {style: containerStyle},
      React.createElement('div', {style: cardStyle},
        React.createElement('h1', null, 'Verifying Payment...'),
        React.createElement('p', null, 'Please wait')
      )
    );
  }

  if (status === 'failed') {
    return React.createElement('div', {style: containerStyle},
      React.createElement('div', {style: cardStyle},
        React.createElement('h1', null, 'Verification Failed'),
        React.createElement('p', null, error),
        React.createElement('button', {style: buttonStyle, onClick: handleGoHome}, 'Go Home')
      )
    );
  }

  var amount = orderData && orderData.amount ? orderData.amount / 100 : 0;
  var reference = orderData && orderData.reference ? orderData.reference : 'N/A';

  return React.createElement('div', {style: containerStyle},
    React.createElement('div', {style: cardStyle},
      React.createElement('h1', {style: successTitleStyle}, 'Payment Successful!'),
      React.createElement('p', null, 'Reference: ' + reference),
      React.createElement('p', null, 'Amount: NGN ' + amount.toLocaleString()),
      React.createElement('p', null, 'A confirmation email has been sent.'),
      React.createElement('button', {style: buttonStyle, onClick: handleGoHome}, 'Go Home'),
      React.createElement('button', {style: buttonStyle, onClick: handleShopMore}, 'Shop More')
    )
  );
}

export default PaymentSuccessPage;