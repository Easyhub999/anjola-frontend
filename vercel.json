{
  "rewrites": [
    {
      "source": "/admin-orders/new",
      "destination": "/seo/admin-orders.html"
    },
    {
      "source": "/admin/products/new",
      "destination": "/seo/admin.html"
    },
    {
      "source": "/payment-return",
      "destination": "/seo/payment-return.html"
    },
    {
      "source": "/product/:id",
      "destination": "/api/product?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/shop",
      "destination": "/seo/shop.html"
    },
    {
      "source": "/blog",
      "destination": "/seo/blog.html"
    },
    {
      "source": "/contact",
      "destination": "/seo/contact.html"
    },
    {
      "source": "/shipping-policy",
      "destination": "/seo/shipping-policy.html"
    },
    {
      "source": "/returns-policy",
      "destination": "/seo/returns-policy.html"
    },
    {
      "source": "/auth",
      "destination": "/seo/auth.html"
    },
    {
      "source": "/profile",
      "destination": "/seo/profile.html"
    },
    {
      "source": "/checkout",
      "destination": "/seo/checkout.html"
    },
    {
      "source": "/admin",
      "destination": "/seo/admin.html"
    },
    {
      "source": "/admin-orders",
      "destination": "/seo/admin-orders.html"
    },
    {
      "source": "/admin-analytics",
      "destination": "/seo/admin-analytics.html"
    },
    {
      "source": "/product",
      "destination": "/seo/product.html"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/product.js": {
      "includeFiles": "build/seo/product.html",
      "maxDuration": 30
    },
    "api/sitemap.js": {
      "maxDuration": 30
    }
  },
  "buildCommand": "npm run build"
}
